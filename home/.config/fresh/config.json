{
  "theme": "builtin://nord",
  "active_keybinding_map": "macos-gui",
  
  "languages": {
    "rust": {
      "format_on_save": true        
    },
    "toml": {
      "format_on_save": true,
      "formatter": {
        "command": "taplo",
        "args": ["fmt", "-", "--option", "align_entries=true"],
        "stdin": true,
        "timeout_ms": 10000
      }
    }
  },
  
  "lsp": {
    "rust": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  
  "version": 2,
  "plugins": {
    "welcome_screen": {
      "enabled": false,
    },
    "welcome": {
      "enabled": false,
    },
    "vi_mode": {
      "enabled": false,
    }
  }
}